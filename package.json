{
  "name": "@local/dsh-conversation-width",
  "version": "1.0.0",
  "private": true,
  "description": "Sets the conversation content width as a percentage of the main column, from a row in Settings -> General.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weng5040/dsh-conversation-width.git"
  },
  "homepage": "https://github.com/weng5040/dsh-conversation-width#readme",
  "bugs": {
    "url": "https://github.com/weng5040/dsh-conversation-width/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
