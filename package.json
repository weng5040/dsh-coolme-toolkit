{
  "name": "@local/dsh-coolme-toolkit",
  "version": "2.1.0",
  "private": true,
  "description": "CoolMe's personal dsh toolkit: conversation width, settings size, service restart, and fake-ip-aware web_fetch.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weng5040/dsh-coolme-toolkit.git"
  },
  "homepage": "https://github.com/weng5040/dsh-coolme-toolkit#readme",
  "bugs": {
    "url": "https://github.com/weng5040/dsh-coolme-toolkit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "toolkit"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./fake-ip": "./fake-ip.js",
    "./service-restart": "./service-restart.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "fake-ip.js",
    "service-restart.js",
    "client.js",
    "verify.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
